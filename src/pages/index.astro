  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="brand" href="#top">
          <span class="brand-mark" aria-hidden="true" style="padding:0; overflow:hidden; display:flex; align-items:center; justify-content:center;">
            <img src="/assets/icon.png" alt="KomaShift logo" width="30" height="30" style="object-fit:contain; border-radius:6px;" />
          </span>
          <span>KomaShift<small>Local comic reader &amp; AI translation</small></span>
        </a>
        <p>An open-source Windows desktop reader for local comic collections with on-demand context-aware AI translation.</p>
      </div>
      <div class="footer-cols">
        <div>
          <h4>Product</h4>
          <ul>
            <li><a href="#highlights">Highlights</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#gallery">Screenshots</a></li>
          </ul>
        </div>
